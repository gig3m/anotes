{
  "name": "anotes",
  "version": "0.3.0",
  "private": true,
  "description": "Apple Notes on the Omarchy desktop, over an applenotes daemon",
  "license": "MIT",
  "scripts": {
    "start": "npm run build && ELECTRON_OZONE_PLATFORM_HINT=auto electron43 src/main/main.ts",
    "build": "npm run build:preload && npm run build:renderer",
    "build:preload": "esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/preload.cjs",
    "build:renderer": "esbuild src/renderer/renderer.ts --bundle --format=esm --outfile=dist/renderer/renderer.js",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no unit tests: the editor holds Markdown, so there is nothing to convert\" && exit 0",
    "install-desktop": "node scripts/install-desktop.js"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.24",
    "typescript": "^5"
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "esbuild@0.24.2": true
  },
  "type": "module",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3"
  }
}
